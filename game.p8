pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
tiles = {}pal({10, 11, 12, -15}, 1)
for y=0,63 do
	tiles[y] = {}
	for x=0,63 do
		tiles[y][x] = rnd(3)\1+1
	end
end
enemies = {}s = {"🐱", "😐", "웃"}plr_x = 64plr_y = 64t = 0water = 75hp = 100atk_dur = 0atk = 1exp = 0day = true
::_::cls()if btn(3) and plr_y <= 315 then
	plr_y += 1
elseif btn(2) and plr_y >= 0 then
	plr_y -= 1
end if btn(0) and plr_x >= 0 then
	plr_x -= 1
elseif btn(1) and plr_x <= 315 then
	plr_x += 1
end plr_tl_x = plr_x\5plr_tl_y = plr_y\5
if btnp(4) and tiles[plr_tl_y][plr_tl_x] == 3 then
	tiles[plr_tl_y][plr_tl_x] = 1
	water = min(water+10, 75)
	?"\ai6v2e2d1c1c1"
end if btnp(5) and atk_dur == 0 then
	?"\ai6v2e3d3c2b1"
	atk_dur = 10
	for i=1,#enemies do
		if enemies[i] then
			if abs(enemies[i][2]-plr_x) < 10 and abs(enemies[i][3]-plr_y) < 10 and enemies[i][5] == 0 then
				enemies[i][4] -= atk
				enemies[i][5] = 10
				if enemies[i][4] <= 0 then
					exp+=enemies[i][1]*10+rnd(20)\1
					hp=min(hp+enemies[i][1]*10,95+atk*5)
					if exp >= atk*100 then
						?"\ai3s8v2eafb"
						atk+= 1exp = 0
					end
					deli(enemies,i)
				end
			end
		end
	end
end
t += 1
if t % 19 == 0 then
	water = max(water-1, 0)
	if (water == 0)hp -= 1
end
if t % 1800 == 0 then
	day = not day if (day)pal({10, 11, 12, -15}, 1)else pal({4, 3, 1, -15}, 1)
end
if t % 30 == 0 and rnd(5)\1 == 0 then
	enemies[#enemies+1] = {0, rnd(300)+10, rnd(300)+10, rnd(3+atk/2)\1, 0, 0}
elseif t % 60 == 0 then
	if day then
		if rnd(15)\1 == 0 then
			enemies[#enemies+1] = {rnd(atk+1)\1, rnd(300)+10, rnd(300)+10, rnd(5)\1, 0, (rnd(2)\1)+1}
		end
	else
		if rnd(10)\1 == 0 then
			enemies[#enemies+1] = {rnd(atk+2)\1, rnd(300)+10, rnd(300)+10, rnd(5)\1, 0, (rnd(2)\1)+1}
		end
	end
end
cam_x=plr_x-62cam_y=plr_y-63camera(cam_x, cam_y)start_x=max(cam_x \ 5, 0)end_x=min((cam_x + 128) \ 5, 63)start_y=max(cam_y \ 5, 0)end_y=min((cam_y + 128) \ 5, 63)
for y=start_y,end_y do
	for x=start_x,end_x do
		rectfill(x*5, y*5, (x+1)*5, (y+1)*5, tiles[y][x])
	end
end
rect(plr_tl_x*5, plr_tl_y*5, plr_tl_x*5+4, plr_tl_y*5+4, 7)
if atk_dur != 0 then 
	atk_dur -= 1
	circfill(plr_x, plr_y, 7, 8)
end
for i=1,#enemies do
	if enemies[i][1] == 0 then
		if rnd(2)\1 == 1 then
			enemies[i][3] += rnd(4)-2
			enemies[i][2] += rnd(4)-2
			enemies[i][3] = min(max(enemies[i][3], 0), 315)
			enemies[i][2] = min(max(enemies[i][2], 0), 315)
		end
		if enemies[i][5] == 0 then
			?"★",enemies[i][2],enemies[i][3],9
		else
			enemies[i][5] -= 1
			?"★",enemies[i][2],enemies[i][3],(enemies[i][5]%2)+8
		end
	else
		if rnd(2)\1 == 1 then
			dir = atan2(plr_x-enemies[i][2], plr_y-enemies[i][3])
			enemies[i][3] = min(max(enemies[i][3]+sin(dir)*1.5, 0), 315)
			enemies[i][2] = min(max(enemies[i][2]+cos(dir)*1.5, 0), 315)
			if abs(enemies[i][2]-plr_x) < 10 and abs(enemies[i][3]-plr_y) < 10 and enemies[i][5] == 0 then
				hp -= enemies[i][1]
			end
		end
		if enemies[i][5] == 0 then
			?s[enemies[i][6]],enemies[i][2],enemies[i][3],9
		else
			enemies[i][5] -= 1
			?s[enemies[i][6]],enemies[i][2],enemies[i][3],(enemies[i][5]%2)+8
		end
	end
end
if (hp==0) print("\as8bagfedc")goto dead
?"웃",plr_x-3,plr_y-2,0
?"dmg: "..atk..", time: "..((t\30)%120).."\nhp: "..hp.."/"..(95+atk*5).."\nwater: "..water.."/75\nexp: "..exp.."/"..(atk*100),plr_x-61,plr_y+40,4
flip()goto _
::dead::cls()camera()
?"you died!\nreached level: "..atk.." ("..atk*100-100+exp..")\nthanks for playing!\n-rewind",5,5,7
flip()goto dead
