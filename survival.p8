pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
tiles = {}
pal({10, 11, 12}, 1)
for y=0,63 do
	tiles[y] = {}
	for x=0,63 do
		tiles[y][x] = rnd(3)+1
	end
end

plr_x = 64
plr_y = 64
t = 0
water = 100
day = true
::_::
cls()

if btn(⬇️) and plr_y <= 315 then
	plr_y += 1
elseif btn(⬆️) and plr_y >= 0 then
	plr_y -= 1
end
if btn(⬅️) and plr_x >= 0 then
	plr_x -= 1
elseif btn(➡️) and plr_x <= 315 then
	plr_x += 1
end
t += 1
if t % 23 == 0 then
	water -= 1
end
if t % 1800 == 0 then
	day = not day
	if day then
		pal({10, 11, 12}, 1)
	else
		pal({4, 3, 1}, 1)
	end
end
cam_x=plr_x-62cam_y=plr_y-63
camera(cam_x, cam_y)

start_x=max(cam_x \ 5, 0)
end_x=min((cam_x + 128) \ 5, 63)
start_y=max(cam_y \ 5, 0)
end_y=min((cam_y + 128) \ 5, 63)
for y=start_y,end_y do
	for x=start_x,end_x do
		rectfill(x*5, y*5, (x+1)*5, (y+1)*5, tiles[y][x])
	end
end
rect(((plr_x+2)\5)*5, ((plr_y+2)\5)*5, ((plr_x+2)\5)*5+4, ((plr_y+2)\5)*5+4, 7)
?"웃",plr_x-1,plr_y,0
?"dmg: 1, time: "..((t\30)%120).."\nhp: 100/100\nwater: "..water.."/100\nexp: 100/100",plr_x-61,plr_y+40,0

flip()
goto _
__gfx__
